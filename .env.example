# ===== Database =====
# Local docker-compose Postgres by default. For Supabase, swap in the connection
# string from Project Settings > Database > Connection string (URI, use the
# "Session pooler" host on port 5432 or 6543 depending on plan).
DATABASE_URL=jdbc:postgresql://localhost:5432/clearwatch
DATABASE_USERNAME=clearwatch
DATABASE_PASSWORD=clearwatch

# ===== Auth =====
# Seeded admin login (created on first boot if no users exist)
ADMIN_EMAIL=admin@clearwatch.dev
ADMIN_PASSWORD=ChangeMe123!
# Secret used to sign JWTs. Generate your own for anything beyond local demo:
#   openssl rand -base64 48
JWT_SECRET=dev-only-clearwatch-secret-change-me-please-1234567890
JWT_EXPIRATION_MS=86400000

# ===== Simulator =====
# The simulator is what keeps the dashboards moving. Leave it on.
SIMULATOR_ENABLED=true
# Speed multiplier: 1 = realistic pacing, higher = faster demo pacing
SIMULATOR_SPEED=1
# How often (minutes) a failure scenario is triggered on some service
SIMULATOR_FAILURE_INTERVAL_MINUTES=15

# ===== Retention =====
RETENTION_DAYS=7

# ===== Server =====
SERVER_PORT=8080

# ===== Client =====
VITE_API_BASE_URL=http://localhost:8080
